# Postgres (Neon via Vercel) — app runtime reads POSTGRES_URL through
# @vercel/postgres; DATABASE_URL_UNPOOLED is used only by `npm run db:migrate`
# for DDL. Both get set automatically if you provision via `vercel integration
# add neon` and run `vercel env pull`.
POSTGRES_URL=
DATABASE_URL_UNPOOLED=

# OpenAI
OPENAI_API_KEY=
# Optional overrides — defaults are gpt-4o-mini / text-embedding-3-small
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=

# Admin dashboard login (/admin) — generate ADMIN_PASSWORD_HASH with:
#   node -e 'const{scryptSync,randomBytes}=require("crypto");const s=randomBytes(16).toString("hex");console.log(s+":"+scryptSync("<password>",s,64).toString("hex"))'
# ADMIN_SESSION_SECRET signs the login session cookie — any random 32-byte hex string.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Contact / Start a Project email delivery (Nodemailer via Gmail)
SMTP_EMAIL=
SMTP_PASSWORD=
